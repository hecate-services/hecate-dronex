%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_dronex.
%%
%% THIS EXISTS SO A SWARM BRED ON ONE MACHINE CAN ATTACK A SWARM BRED ON
%% ANOTHER, AND SO THE CONTROLLER THAT WINS CAN LEAVE THE SIMULATOR AND FLY.
%%
%% One node runs one island: a roster of drone controllers, a trainer, a static
%% sensor network defending its own airspace, and an airspace where fights
%% happen. CHARTER.md says the rest.
%%
%% ONE RELEASE, WHERE THERE WERE TWO. The counter-UAS line split `dronex_edge'
%% from `dronex_sim' with a hard wall between a production site brain and a
%% simulator. An island is both, so the wall has nothing left to separate.
%% design/DESIGN_THE_SECOND_ACT.md says what of that line came forward.
%%
%% SCAFFOLD FIRST, ON PURPOSE AND FOR A RECORDED REASON. The release, the image,
%% the CI and the deployment are the tedious end and the one that is expensive to
%% retrofit. That end is finished before the interesting end starts, so no
%% increment is ever blocked waiting on plumbing.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) and the whole reckon-db stack transitively.
    {hecate_om, "~> 0.8"},

    %% ==========================================================================
    %% THE NEURAL SUBSTRATE, AND WHY IT IS A DEPENDENCY RATHER THAN OUR CODE
    %% ==========================================================================
    %%
    %% `network_evaluator' is a flat synchronous network with `get_weights/1' and
    %% `set_weights/2' over a plain float vector, CfC neurons carrying internal
    %% state, in-episode plasticity, a Rust NIF path, and `network_onnx:to_onnx/1'
    %% beside it. That last one is why the charter's framing is a file rather
    %% than an aspiration: an evolved controller leaves the BEAM.
    %%
    %% ⚠ >= 2.0.1 IS NOT A PREFERENCE. 2.0.0 is published and UNBUILDABLE: it
    %% shipped without native/, so priv/build-nifs.sh hard-errors. 1.x carries a
    %% broken ONNX export, a silent NIF fallback and four NIF contract bugs.
    %%
    %% ⚠⚠ NOTHING HERE USES `robo_*', WHICH IS LEAVING THAT LIBRARY. The debt to
    %% it is design rather than code and it is credited in README.md.
    %%
    %% ⚠⚠⚠ IT IS HERE AT THE SPINE RATHER THAN AT THE FIRST MODULE THAT NEEDS IT.
    %% It carries a Rust NIF, so it is exactly the kind of plumbing that fails in
    %% the container build and not on a laptop. Finding that out now is the whole
    %% point of building the tedious end first.
    %%
    %% design/DESIGN_WHAT_WE_TAKE_FROM_FABER.md draws the whole boundary,
    %% including the two occasions the survey behind it was got wrong.
    {faber_tweann, "~> 2.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The sibling services' block, verbatim, and it is load-bearing. Without it the
%% run ends on one `Unknown function macula:publish/4' for ever, because macula
%% arrives transitively through hecate_om and rebar3's default plt holds direct
%% deps only. A gate that is red for a reason nobody can fix is a gate everybody
%% learns to skip.
{dialyzer, [
    {warnings, [no_unknown]},
    %% ⚠ COWBOY ARRIVES TRANSITIVELY THROUGH hecate_om, so it is not in the plt
    %% by default. Named directly rather than widening the plt to every
    %% transitive dep.
    {plt_extra_apps, [cowboy, ranch]},
    {exclude_apps, [
        macula, macula_envy, macula_mdns,
        reckon_db, reckon_evoq, reckon_gater, evoq,
        khepri, ra, horus, aten, seshat, gen_batch_server,
        gproc, msgpack, jsx,
        %% faber_tweann carries the DXNN genotype path over mnesia, which
        %% nothing here calls. `faber_boundary_tests' asserts that.
        faber_tweann, mnesia
        %% ⚠ cowboy AND ranch ARE DELIBERATELY ABSENT HERE. See above.
    ]}
]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {hecate_dronex, "0.1.0"}, [hecate_dronex, dronex_contracts, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
